{
  "name": "@pracht/experiments",
  "version": "0.1.1",
  "description": "Small publish/staged-publish package used to exercise Staged Publish Review.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pracht-experiments": "./cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "cli.js",
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "pack:dry-run": "npm pack --dry-run",
    "publish:public": "npm publish --access public",
    "stage:publish": "npm stage publish --access public"
  },
  "publishConfig": {
    "access": "public"
  }
}
