{
  "name": "@drydock/detonation-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Standalone dynamic-analysis prototype for Drydock proposal #7. NOT part of the Worker deploy target and never imported by it.",
  "bin": {
    "detonate": "./bin/detonate.mjs"
