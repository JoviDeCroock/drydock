{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "staged-publish-review",
	"main": "./server/index.ts",
	"compatibility_date": "2026-05-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1,
			"persist": true
		}
	},
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"ai": {
		"binding": "AI"
	},
	"analytics_engine_datasets": [
		{
			"binding": "PRODUCT_ANALYTICS",
			"dataset": "drydock_product_events"
		}
	],
	"flagship": [
		{
			"binding": "FLAGS",
			"app_id": "ba0fc327-0ea4-4c39-ad70-7ee70a33c6e3"
		}
	],
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "staged-publish-review",
			"database_id": "9c856c2f-51be-4309-a932-103e6a835430",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "COMPARE_CACHE",
			"id": "b47f398d73b4446fbb4a7be3c4f1081a"
		},
		{
			// Better Auth session store (secondary storage). Keeps the
			// per-request session lookup off the D1 single writer. Create with:
			// pnpm exec wrangler kv namespace create AUTH_SESSIONS
			"binding": "AUTH_SESSIONS",
			"id": "REPLACE_WITH_AUTH_SESSIONS_KV_ID"
		}
	],
	// Native Rate Limiting bindings: per-colo fixed-window counters that keep
	// abuse control off D1. One binding per per-minute limit the app enforces;
	// see NATIVE_TIERS in server/lib/platform/rate-limit.ts. `namespace_id` is a
	// per-Worker identifier we choose, not an account resource to provision.
	"ratelimits": [
		{
			"name": "RATE_LIMIT_10_PER_MINUTE",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_20_PER_MINUTE",
			"namespace_id": "1002",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_30_PER_MINUTE",
			"namespace_id": "1003",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_60_PER_MINUTE",
			"namespace_id": "1004",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_120_PER_MINUTE",
			"namespace_id": "1005",
			"simple": {
				"limit": 120,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_240_PER_MINUTE",
			"namespace_id": "1006",
			"simple": {
				"limit": 240,
				"period": 60
			}
		}
	],
	"r2_buckets": [
		{
			"binding": "ARTIFACTS",
			"bucket_name": "staged-publish-review-artifacts"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "SCAN_QUEUE",
				"queue": "staged-publish-review-scans"
			}
		],
		"consumers": [
			{
				"queue": "staged-publish-review-scans",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_concurrency": 10,
				"max_retries": 3,
				"dead_letter_queue": "staged-publish-review-scans-dlq"
			}
		]
	},
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	"routes": [
		{
			"pattern": "drydock.org",
			"custom_domain": true
		},
		{
			"pattern": "drydock.resynapse.dev",
			"custom_domain": true
		},
		{
			"pattern": "drydock.resynapse.dev/b/*",
			"zone_name": "resynapse.dev"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "https://drydock.org",
		"AI_CACHE_AFFINITY": "staged-publish-review-release-reviewer-v1",
		"NPM_REGISTRY": "https://registry.npmjs.org",
		"PNPM_VERSION": "11.1.1",
		"EMAIL_FROM_ADDRESS": "drydock@drydock.org",
		"EMAIL_FROM_NAME": "Drydock",
		"GITHUB_APP_ID": "3896399",
		"GITHUB_APP_SLUG": "drydock-review",
		"GITHUB_APP_CLIENT_ID": "Iv23lid3JXi9WSYbS6pn",
		"SLACK_CLIENT_ID": "11207701524854.11303157530208"
	}
}
