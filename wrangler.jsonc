{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "staged-publish-review",
	"main": "./server/index.ts",
	"compatibility_date": "2026-05-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"ai": {
		"binding": "AI"
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "staged-publish-review",
			"database_id": "9c856c2f-51be-4309-a932-103e6a835430",
			"migrations_dir": "drizzle"
		}
	],
	"vars": {
    "BETTER_AUTH_URL": "https://staged-publish-review.decroockjovi.workers.dev",
		"AI_MODEL": "@cf/moonshotai/kimi-k2.5",
		"AI_CACHE_AFFINITY": "stage-shield-release-reviewer-v1",
		"NPM_REGISTRY": "https://registry.npmjs.org"
	}
}
