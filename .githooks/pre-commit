#!/usr/bin/env sh
# Pre-commit gate: lint + format check + typecheck + tests must all pass.
# Skip with `git commit --no-verify` only if you know what you are doing.
set -e

cd "$(git rev-parse --show-toplevel)"

# Pick a package manager that exists on the user's PATH.
if command -v pnpm >/dev/null 2>&1; then
  exec pnpm run verify
elif command -v npm >/dev/null 2>&1; then
  exec npm run verify
else
  echo "pre-commit: pnpm or npm is required to run the verify gate" >&2
  exit 1
fi
