# Local Worker secrets and environment overrides.
# Copy to .dev.vars for `pnpm dev`; do not commit .dev.vars.

# Required. Better Auth signs/encrypts sessions and every non-auth API endpoint requires a session.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret

# Canonical app origin used by Better Auth. For local dev this matches Vite's default URL.
BETTER_AUTH_URL=http://localhost:5173

# Required. Dedicated key material for encrypting per-organization npm connections.
NPM_CONNECTIONS_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret

# Self-host posture: scans require an encrypted per-organization npm connection.
# Create one from the dashboard before scanning staged publishes.

# Optional local overrides for non-secret vars that are also defined in wrangler.jsonc.
# NPM_REGISTRY=https://registry.npmjs.org
# AI_CACHE_AFFINITY=staged-publish-review-release-reviewer-v1

# Optional. Skip the production security headers (CSP/HSTS/etc.) for local dev.
# The strict CSP blocks Vite's HMR client and HSTS pins http://localhost to HTTPS.
# Local dev only — this var is intentionally absent from every deployed config.
# DISABLE_SECURITY_HEADERS=true

# The AI reviewer is gated by the Cloudflare Flagship flag `ai-review` in the
# `drydock` app (see the `flagship` binding in the selected Wrangler config).
# Toggle it from the Cloudflare dashboard; there is no .dev.vars override.

# Optional GitHub App workflow-gate integration. Public identifiers normally
# live in the selected Wrangler config; keep secrets in .dev.vars locally or in
# Wrangler secrets when deployed.
# GITHUB_APP_ID=replace-with-your-app-id
# GITHUB_APP_SLUG=replace-with-your-app-slug
# GITHUB_APP_CLIENT_ID=replace-with-your-client-id
# GITHUB_APP_CLIENT_SECRET=replace-with-your-client-secret
# GITHUB_APP_PRIVATE_KEY=replace-with-your-pem-private-key
# GITHUB_APP_WEBHOOK_SECRET=replace-with-your-webhook-secret
# GITHUB_APP_STATE_SECRET=replace-with-a-random-32-byte-secret

# Optional Slack notifications.
# SLACK_CLIENT_ID=replace-with-your-client-id
# SLACK_CLIENT_SECRET=replace-with-your-client-secret
