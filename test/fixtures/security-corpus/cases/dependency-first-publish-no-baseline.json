{
  "id": "dependency-first-publish-no-baseline",
  "title": "First-ever publish does not flood added-dependency findings",
  "category": "dependency-supply-chain",
  "intent": "Without a baseline manifest every dependency diffs as added; the delta rules (dependency.added / dependency.major-bump) must stay silent so a routine first release is not floored at medium risk, while optional-added still fires because it describes the staged manifest itself.",
  "stagedPackageJson": {
    "name": "dependency-first-publish-no-baseline",
    "version": "1.0.0",
    "main": "index.js",
    "dependencies": {
      "left-pad": "^1.3.0",
      "event-pubsub": "4.3.0"
    },
    "peerDependencies": {
      "preact": "^10.0.0"
    },
    "optionalDependencies": {
      "fsevents": "^2.0.0"
    }
  },
  "stagedFiles": [
    {
      "path": "package.json",
      "size": 220,
      "sha256": "staged-package-json",
      "flags": [],
      "textSample": "{\"name\":\"dependency-first-publish-no-baseline\",\"version\":\"1.0.0\",\"main\":\"index.js\",\"dependencies\":{\"left-pad\":\"^1.3.0\",\"event-pubsub\":\"4.3.0\"},\"peerDependencies\":{\"preact\":\"^10.0.0\"},\"optionalDependencies\":{\"fsevents\":\"^2.0.0\"}}"
    },
    {
      "path": "index.js",
      "size": 20,
      "sha256": "index-v1",
      "flags": [],
      "textSample": "export default 1;\n"
    }
  ],
  "expectedRisk": "high",
  "expectedFindings": [
    {
      "ruleId": "dependency.optional-added",
      "severity": "high",
      "file": "package.json"
    }
  ],
  "expectedPackageJsonDiff": {
    "hasPreviousManifest": false
  }
}
