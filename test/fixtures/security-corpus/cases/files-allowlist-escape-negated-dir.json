{
  "id": "files-allowlist-escape-negated-dir",
  "title": "Payloads sit where npm-packlist semantics exclude them: a negated directory and a loaded doc file",
  "category": "tarball-manifest-mismatch",
  "intent": "The files allowlist is matched the way npm-packlist reads it (root-anchored entries, `/dist` with a leading slash, `!` negations that drop a directory). A hook file inside the negated dist/test directory and a JavaScript payload disguised as notes.md are files npm pack would never have emitted. The disguised doc is required by the entrypoint, so the documentation demotion must not apply and both keep high severity on an added file.",
  "previousPackageJson": {
    "name": "files-allowlist-escape-negated-dir",
    "version": "2.0.0",
    "main": "dist/index.js",
    "files": ["/dist", "!/dist/test"]
  },
  "stagedPackageJson": {
    "name": "files-allowlist-escape-negated-dir",
    "version": "2.0.1",
    "main": "dist/index.js",
    "files": ["/dist", "!/dist/test"]
  },
