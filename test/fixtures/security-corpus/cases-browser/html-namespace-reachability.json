{
  "id": "browser-html-namespace-reachability",
  "title": "WebExtension document reachability respects HTML, SVG, and MathML parsing",
  "category": "browser-extension",
  "intent": "Inert templates, non-executable script types, MathML scripts, SVG iframes, CDATA sections, raw-text iframe contents, and trailing solidus on HTML start tags must not invent consumer edges, while MathML-to-SVG content, SVG HTML integration points, executable MathML integration-point scripts, and href or xlink:href SVG scripts and links remain consumer entrypoints.",
