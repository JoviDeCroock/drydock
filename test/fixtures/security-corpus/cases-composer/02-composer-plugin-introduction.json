          "flags": [],
          "textSample": "{\"name\": \"acme/demo-package\", \"version\": \"1.1.0\", \"type\": \"library\"}"
        }
      ]
    }
  ],
  "expectedRisk": "high",
  "expectedFindings": [
    {
      "ruleId": "composer.plugin",
      "severity": "high",
      "file": "dist/demo-package-1.2.0.zip/composer.json"
    },
    {
      "ruleId": "composer.plugin-api-requirement",
      "severity": "high",
      "file": "dist/demo-package-1.2.0.zip/composer.json"
    }
  ]
