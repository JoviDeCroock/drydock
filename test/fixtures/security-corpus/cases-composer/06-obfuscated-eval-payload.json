{
  "id": "composer-obfuscated-eval-payload",
  "title": "changed PHP source gains an obfuscated eval payload",
  "category": "runtime-execution",
  "intent": "a version bump that adds base64-decoded eval and shell execution to existing source must be flagged by the shared code rules",
  "manifest": {
    "schema": "drydock.release-artifacts.v1",
    "ecosystem": "composer",
