{
  "id": "legit-provenance-pypi-repository-renamed",
  "title": "PyPI publisher repository renamed within the same owner",
  "category": "control",
  "intent": "PyPI's publisher record carries no repository id, so a GitHub rename under the same owner looks like a new repository by name. A change that keeps the owner is reported as low context.",
  "ecosystem": "pypi",
  "registryProvenance": {
    "packageName": "example-sdk",
    "baseline": {
      "version": "2.0.0",
      "files": [
        {
          "filename": "example_sdk-2.0.0.tar.gz",
          "status": 200,
          "body": {
            "version": 1,
            "attestation_bundles": [
              {
                "publisher": {
                  "kind": "GitHub",
                  "repository": "example-org/example-sdk",
                  "workflow": "release.yml",
                  "environment": "pypi"
                },
                "attestations": []
              }
            ]
          }
        }
      ]
    },
    "candidate": {
      "version": "2.0.1",
      "files": [
        {
          "filename": "example_sdk-2.0.1.tar.gz",
          "status": 200,
          "body": {
            "version": 1,
            "attestation_bundles": [
              {
                "publisher": {
                  "kind": "GitHub",
                  "repository": "example-org/example-sdk-python",
                  "workflow": "release.yml",
                  "environment": "pypi"
                },
                "attestations": []
              }
            ]
          }
        }
      ]
    }
  },
  "expectedRisk": "low",
  "expectedFindings": [
    {
      "ruleId": "release.provenance-publisher-changed",
      "severity": "low",
      "file": "<release-process>"
    }
  ],
  "verdict": "benign",
  "threatClass": "legit-provenance-continuity",
  "source": "synthetic",
  "expectMinRisk": "low",
  "expectAnyRule": []
}
