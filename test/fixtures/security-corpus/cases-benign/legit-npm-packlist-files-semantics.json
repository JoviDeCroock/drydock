{
  "id": "legit-npm-packlist-files-semantics",
  "title": "Files allowlist written with npm-packlist syntax the matcher must read like npm (benign hard-negative)",
  "ecosystem": "npm",
  "verdict": "benign",
  "threatClass": "legit-build-infrastructure",
  "source": "benign-popular",
  "intent": "Modeled on manifests in the 2026-10 npm sweep (tsup, ts-node, lit, rxjs, better-sqlite3, knex, yargs, npm itself): leading-slash entries, `/dist/` directory entries with a `!` exclusion, `bin/*` (npm widens it to `bin/**`), brace sets, `[ch]` classes, a `!(...)` extglob, a literal file that a later negation cannot drop, a ./-prefixed bin target, bundled dependencies under node_modules, a nested README, and a root CHANGELOG. Every file here is one npm pack emits, so file.outside-files-list must stay quiet for all of them. The one file outside the list, an unreferenced readme-template.md (nx 23.3.0 ships one), is documentation nothing loads and is disclosed at low severity only.",
  "expectMinRisk": "low",
  "expectAnyRule": [],
  "previousPackageJson": {
    "name": "packlist-shapes",
    "version": "4.0.0",
    "main": "dist/index.js",
    "bin": { "packlist-shapes": "./cli.js" },
    "bundleDependencies": ["tiny-dep"],
    "files": [
      "/dist/",
      "!/dist/test",
      "bin/*",
      "/index.{d.ts,js}",
      "src/**/*.[ch]pp",
      "lib/cjs/**/!(*.tsbuildinfo)",
      "browser.d.ts",
      "!*.d.ts"
    ]
  },
  "stagedPackageJson": {
