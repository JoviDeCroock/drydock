{
  "id": "added-dependency-computed-execfile-skipped-content",
  "title": "A renamed child-process target keeps omitted bodies visible",
  "category": "dependency-introduction",
  "intent": "An install hook can rename a destructured child_process export before passing it a computed executable path. Every deliberately omitted body must remain a visible coverage gap when the target cannot be resolved statically.",
  "previousPackageJson": { "name": "consumer", "version": "1.0.0" },
  "stagedPackageJson": {
    "name": "consumer",
    "version": "1.1.0",
    "dependencies": { "computed-exec": "1.0.0" }
  },
  "dependencyArtifacts": {
    "computed-exec": {
      "version": "1.0.0",
      "packageJson": {
        "name": "computed-exec",
        "version": "1.0.0",
        "scripts": { "postinstall": "node install.js" }
      },
      "files": [
        {
          "path": "package.json",
          "size": 103,
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "textSample": "{\"name\":\"computed-exec\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"node install.js\"}}",
          "flags": []
        },
        {
          "path": "install.js",
          "size": 134,
          "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "textSample": "const path = require('node:path'); const { execFileSync: run } = require('node:child_process'); run(path.join(__dirname, payloadName));",
          "flags": []
        },
        {
          "path": "payload.min.js",
          "size": 4096,
          "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "flags": ["text-sample-skipped"]
        }
      ]
    }
  },
  "expectedDependencies": [
    {
      "name": "computed-exec",
      "status": "uninspectable",
      "reason": "artifact-truncated",
      "resolvedVersion": "1.0.0",
      "fileCount": 3
    }
  ],
  "expectedFindings": [
    {
      "ruleId": "dependency-artifact.uninspectable",
      "severity": "medium",
      "file": "<dependency>computed-exec@1.0.0"
    }
  ],
  "expectedRisk": "medium",
  "expectedRecommendation": "review carefully"
}
