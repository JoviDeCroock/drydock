{
  "id": "added-dependency-shell-target-skipped-content",
  "title": "A shell-expanded lifecycle executable keeps omitted bodies in scope",
  "category": "dependency-introduction",
  "intent": "A lifecycle command can choose its executable from package or environment variables. Drydock must not let a shell-expanded target make deliberately omitted package content appear irrelevant to install execution.",
  "previousPackageJson": { "name": "consumer", "version": "1.0.0" },
  "stagedPackageJson": {
    "name": "consumer",
    "version": "1.1.0",
    "dependencies": { "shell-runner": "1.0.0" }
  },
  "dependencyArtifacts": {
    "shell-runner": {
      "version": "1.0.0",
      "packageJson": {
        "name": "shell-runner",
        "version": "1.0.0",
        "scripts": { "postinstall": "sh -c \"./$TARGET\"" }
      },
      "files": [
        {
          "path": "package.json",
          "size": 112,
          "sha256": "shell-runner-package-json",
          "textSample": "{\"name\":\"shell-runner\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"sh -c \\\"./$TARGET\\\"\"}}",
          "flags": []
        },
        {
          "path": "payload.min.js",
          "size": 4096,
          "sha256": "shell-runner-payload",
          "flags": ["text-sample-skipped"]
        }
      ]
    }
  },
  "expectedDependencies": [
    {
      "name": "shell-runner",
      "section": "dependencies",
      "declaredSpec": "1.0.0",
      "declarationKind": "exact",
      "status": "uninspectable",
      "reason": "artifact-truncated",
      "resolvedVersion": "1.0.0",
      "fileCount": 2,
      "observation": {
        "execution": "observed",
        "risk": "not-observed",
        "dynamicInstallTarget": true
      }
    }
  ],
  "expectedFindings": [
    {
      "ruleId": "dependency-artifact.uninspectable",
      "severity": "medium",
      "file": "<dependency>shell-runner@1.0.0"
    }
  ],
  "expectedRisk": "medium",
  "expectedRecommendation": "review carefully"
}
