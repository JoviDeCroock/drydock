{
  "id": "added-dependency-direct-node-skipped-content",
  "title": "A direct Node lifecycle target keeps omitted bodies visible",
  "category": "dependency-introduction",
  "intent": "A Node lifecycle command can select its entry script through shell expansion without a child-process call. The executable operand must keep deliberately omitted package content visible as an inspection gap.",
  "previousPackageJson": { "name": "consumer", "version": "1.0.0" },
  "stagedPackageJson": {
    "name": "consumer",
    "version": "1.1.0",
    "dependencies": { "direct-node": "1.0.0" }
  },
  "dependencyArtifacts": {
    "direct-node": {
      "version": "1.0.0",
      "packageJson": {
        "name": "direct-node",
        "version": "1.0.0",
        "scripts": { "postinstall": "node \"$PAYLOAD\"" }
      },
      "files": [
        {
          "path": "package.json",
          "size": 107,
          "sha256": "direct-node-package-json",
          "textSample": "{\"name\":\"direct-node\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"node \\\"$PAYLOAD\\\"\"}}",
          "flags": []
        },
        {
          "path": "payload.min.js",
          "size": 4096,
          "sha256": "direct-node-payload",
          "flags": ["text-sample-skipped"]
        }
      ]
    }
  },
  "expectedDependencies": [
    {
      "name": "direct-node",
      "status": "uninspectable",
      "reason": "artifact-truncated",
      "resolvedVersion": "1.0.0",
      "fileCount": 2,
      "observation": {
        "execution": "observed",
        "risk": "not-observed",
        "dynamicInstallTarget": true
      }
    }
  ],
  "expectedFindings": [
    {
      "ruleId": "dependency.artifact-unavailable",
      "severity": "medium",
      "file": "<dependency>direct-node@1.0.0"
    }
  ],
  "expectedRisk": "medium",
  "expectedRecommendation": "review carefully"
}
