{
  "id": "added-dependency-install-skipped-content",
  "title": "An install-reachable minified file with omitted text fails visibly",
  "category": "dependency-introduction",
  "intent": "The parser deliberately omits minified JavaScript bodies. When an install hook executes such a file, Drydock cannot grade the dependency from the omitted evidence and must require manual review instead of treating the hook as harmless.",
  "previousPackageJson": { "name": "consumer", "version": "1.0.0", "main": "index.js" },
  "stagedPackageJson": {
    "name": "consumer",
    "version": "1.1.0",
    "main": "index.js",
    "dependencies": { "skipped-install": "1.0.0" }
  },
  "dependencyArtifacts": {
    "skipped-install": {
      "version": "1.0.0",
      "packageJson": {
        "name": "skipped-install",
        "version": "1.0.0",
        "scripts": { "postinstall": "node install.min.js" }
      },
      "files": [
        {
          "path": "package.json",
          "size": 108,
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "textSample": "{\"name\":\"skipped-install\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"node install.min.js\"}}",
          "flags": []
        },
        {
          "path": "install.min.js",
          "size": 4096,
          "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "flags": ["text-sample-skipped"]
        }
      ]
    }
  },
  "expectedDependencies": [
    {
      "name": "skipped-install",
      "section": "dependencies",
      "declaredSpec": "1.0.0",
      "declarationKind": "exact",
      "status": "uninspectable",
      "reason": "artifact-truncated",
      "resolvedVersion": "1.0.0",
      "fileCount": 2,
      "automaticExecution": [{ "kind": "script", "name": "postinstall" }]
    }
  ],
  "expectedFindings": [
    {
      "ruleId": "dependency-artifact.uninspectable",
      "severity": "medium",
      "file": "<dependency>skipped-install@1.0.0"
    }
  ],
  "expectedRisk": "medium",
  "expectedRecommendation": "review carefully"
}
