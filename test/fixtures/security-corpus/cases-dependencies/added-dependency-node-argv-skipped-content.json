{
  "id": "added-dependency-node-argv-skipped-content",
  "title": "Every Node interpreter argv target keeps its omitted script visible",
  "category": "dependency-introduction",
  "intent": "An install hook can preload one packaged script and launch another through the same Node argv. Drydock must retain every static target and report incomplete evidence when any named body was deliberately omitted.",
  "previousPackageJson": { "name": "consumer", "version": "1.0.0" },
  "stagedPackageJson": {
    "name": "consumer",
    "version": "1.1.0",
    "dependencies": { "node-argv-install": "1.0.0" }
  },
  "dependencyArtifacts": {
    "node-argv-install": {
      "version": "1.0.0",
      "packageJson": {
        "name": "node-argv-install",
        "version": "1.0.0",
        "scripts": { "postinstall": "node install.js" }
      },
      "files": [
        {
          "path": "package.json",
          "size": 108,
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "textSample": "{\"name\":\"node-argv-install\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"node install.js\"}}",
          "flags": []
        },
        {
          "path": "install.js",
          "size": 109,
          "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "textSample": "require('node:child_process').spawn('node', ['--require', './retained.js', './payload.min.js'])",
          "flags": []
        },
        {
          "path": "retained.js",
          "size": 24,
          "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
          "textSample": "console.log('retained')",
          "flags": []
        },
        {
          "path": "payload.min.js",
          "size": 4096,
          "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "flags": ["text-sample-skipped"]
        }
      ]
    }
  },
  "expectedDependencies": [
    {
      "name": "node-argv-install",
      "status": "uninspectable",
      "reason": "artifact-truncated",
      "resolvedVersion": "1.0.0",
      "fileCount": 4
    }
  ],
  "expectedFindings": [
    {
      "ruleId": "dependency.artifact-unavailable",
      "severity": "medium",
      "file": "<dependency>node-argv-install@1.0.0"
    }
  ],
  "expectedRisk": "medium",
  "expectedRecommendation": "review carefully"
}
