{
  "id": "added-dependency-node-argv-skipped-content",
  "title": "A Node interpreter argv keeps its omitted script visible",
  "category": "dependency-introduction",
  "intent": "An install hook can launch a packaged script as an argument to the Node interpreter. Drydock must report incomplete evidence when that named script body was deliberately omitted.",
  "previousPackageJson": { "name": "consumer", "version": "1.0.0" },
  "stagedPackageJson": {
    "name": "consumer",
    "version": "1.1.0",
    "dependencies": { "node-argv-install": "1.0.0" }
  },
  "dependencyArtifacts": {
    "node-argv-install": {
      "version": "1.0.0",
      "packageJson": {
        "name": "node-argv-install",
        "version": "1.0.0",
        "scripts": { "postinstall": "node install.js" }
      },
      "files": [
        {
          "path": "package.json",
          "size": 108,
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "textSample": "{\"name\":\"node-argv-install\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"node install.js\"}}",
          "flags": []
        },
        {
          "path": "install.js",
          "size": 82,
          "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "textSample": "require('node:child_process').spawn('node', ['./payload.min.js'])",
          "flags": []
        },
        {
          "path": "payload.min.js",
          "size": 4096,
          "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "flags": ["text-sample-skipped"]
        }
      ]
    }
  },
  "expectedDependencies": [
    {
      "name": "node-argv-install",
      "status": "uninspectable",
      "reason": "artifact-truncated",
      "resolvedVersion": "1.0.0",
      "fileCount": 3
    }
  ],
  "expectedFindings": [
    {
      "ruleId": "dependency-artifact.uninspectable",
      "severity": "medium",
      "file": "<dependency>node-argv-install@1.0.0"
    }
  ],
  "expectedRisk": "medium",
  "expectedRecommendation": "review carefully"
}
