      "version": "1.0.0",
      "packageJson": {
        "name": "dormant-gyp",
        "version": "1.0.0",
        "scripts": {},
        "gypfile": false
      },
      "files": [
        {
          "path": "package.json",
          "size": 76,
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "textSample": "{\"name\":\"dormant-gyp\",\"version\":\"1.0.0\",\"scripts\":{},\"gypfile\":false}",
          "flags": []
        },
        {
          "path": "binding.gyp",
          "size": 64,
          "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "textSample": "{\"variables\":{\"generated\":\"<!(node tools/generate.js)\"}}",
          "flags": []
        },
        {
