      "status": "inspected",
      "resolvedVersion": "2.0.0",
      "observation": { "execution": "observed", "risk": "not-observed" }
    }
  ],
  "expectedFindings": [
    {
      "ruleId": "dependency.install-time-capability",
      "severity": "medium",
      "file": "<dependency>setup-helper@2.0.0:package.json"
    }
  ],
  "expectedRisk": "medium",
  "expectedRecommendation": "review carefully"
}
