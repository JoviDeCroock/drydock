{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Agent-harness hooks: the entry points are invoked by Claude Code and Codex
  // CLI from .claude/settings.json / .codex/hooks.json, which knip can't read.
  "entry": [
    "scripts/hooks/guard-protected-paths.mjs",
    "scripts/hooks/post-edit-check.mjs"
  ],
  "ignore": [
    // Package fixtures are hostile-evidence samples the fixture builder reads as
    // bytes at runtime; they are never part of the module graph.
    "test/e2e-fixtures/**",
    // Lint-rule fixtures deliberately hold "bad" code to exercise the rule.
    "test/fixtures/oxlint-signals/**",
    "test/fixtures/oxlint-boundaries/**"
  ],
  "ignoreDependencies": [
    // `cloudflare:workers` / `cloudflare:test` / `cloudflare:email` are Workers
    // runtime virtual modules, not the `cloudflare` npm package.
    "cloudflare",
    // Referenced only as a JSDoc `import("eslint").Rule` type in the oxlint plugin.
    "eslint"
  ],
  // The agent tour runs Playwright with a second config passed via `--config`
  // from scripts/agent-tour.mjs, which the plugin can't see from package.json.
  "playwright": {
    "config": ["playwright.config.ts", "test/agent-tour/playwright.config.ts"]
  }
}
